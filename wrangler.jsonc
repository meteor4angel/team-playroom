{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-playroom-rooms",
  "main": "worker-dist/index.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "RoomDurableObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }],
  "vars": { "ALLOWED_ORIGINS": "https://team-playroom.pages.dev,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://127.0.0.1:4174" },
  "observability": { "enabled": false }
}


